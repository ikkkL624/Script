-- Calculadora gains real-time (más específica, muestra por día destacado)
strengthTab:AddLabel(" ").TextSize = 10
strengthTab:AddLabel("📈 Gains Real-Time (Strength & Durability)").TextSize = 18

local stopwatchLabel = strengthTab:AddLabel("Fast Rep Time: 0d 0h 0m 0s")
stopwatchLabel.TextSize = 20

local projectedStrengthLabel = strengthTab:AddLabel("Strength Rate: 0 /Hour | 0 /Day | 0 /Week | 0 /Month")
projectedStrengthLabel.TextSize = 18

local dailyStrengthLabel = strengthTab:AddLabel("Strength por Día: 0")  -- Label destacado para por día
dailyStrengthLabel.TextSize = 20
dailyStrengthLabel.TextColor3 = Color3.fromRGB(0, 255, 150)  -- Verde lima

local strengthLabel = strengthTab:AddLabel("Strength: 0 | Gained: 0")
strengthLabel.TextSize = 20

local startTime = tick()
local initialStrength = strengthStat.Value
local trackingStarted = false

local strengthHistory = {}
local calculationInterval = 10

task.spawn(function()
    local lastCalcTime = tick()
    while true do
        local currentTime = tick()
        local currentStrength = strengthStat.Value

        if not trackingStarted and (currentStrength - initialStrength) >= 100e9 then
            trackingStarted = true
            startTime = tick()
            initialStrength = currentStrength
            strengthHistory = {}
        end

        if trackingStarted then
            local elapsed = currentTime - startTime
            local days = math.floor(elapsed / 86400)
            local hours = math.floor((elapsed % 86400) / 3600)
            local mins = math.floor((elapsed % 3600) / 60)
            local secs = math.floor(elapsed % 60)
            stopwatchLabel.Text = string.format("Fast Rep Time: %dd %dh %dm %ds", days, hours, mins, secs)

            local gainedStr = currentStrength - initialStrength
            strengthLabel.Text = "Strength: " .. formatNumber(currentStrength) .. " | Gained: " .. formatNumber(gainedStr)

            table.insert(strengthHistory, {time = currentTime, value = currentStrength})

            while #strengthHistory > 0 and currentTime - strengthHistory[1].time > calculationInterval do
                table.remove(strengthHistory, 1)
            end

            if currentTime - lastCalcTime >= calculationInterval then
                lastCalcTime = currentTime

                if #strengthHistory >= 2 then
                    local delta = strengthHistory[#strengthHistory].value - strengthHistory[1].value
                    local perSec = delta / calculationInterval
                    projectedStrengthLabel.Text = "Strength Rate: " .. formatNumber(math.floor(perSec * 3600)) .. "/Hour | " ..
                                                  formatNumber(math.floor(perSec * 86400)) .. "/Day | " ..
                                                  formatNumber(math.floor(perSec * 604800)) .. "/Week | " ..
                                                  formatNumber(math.floor(perSec * 2592000)) .. "/Month"

                    -- Label destacado por día
                    local dailyStrength = math.floor(perSec * 86400)
                    dailyStrengthLabel.Text = "Strength por Día: " .. formatNumber(dailyStrength)
                end
            end
        end

        task.wait(0.05)
    end
end)

