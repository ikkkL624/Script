        timerLbl.Size = UDim2.new(1, 0, 0, 30)
        timerLbl.Text = "Tiempo: 0:0:0"
        timerLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
        timerLbl.TextSize = 16

