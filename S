        getgenv().AntiAfkExecuted = false
        getgenv().zamanbaslaticisi = false
        if game.CoreGui:FindFirstChild("AntiAfkGUI") then
            game.CoreGui.AntiAfkGUI:Destroy()
        end
        warn("[Misc] Anti-AFK DESACTIVADO")
    end
end)

