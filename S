local function formatTime(elapsed)
    local totalSec = math.floor(elapsed)
    local d = math.floor(totalSec / 86400)
    local h = math.floor((totalSec % 86400) / 3600)
    local m = math.floor((totalSec % 3600) / 60)
    local s = totalSec % 60
    return string.format("%dd %dh %dm %ds", d, h, m, s)
end

local function calculatePaces(rebirths, elapsed)
    local hours = elapsed / 3600
    local days = elapsed / 86400
    local weeks = elapsed / (86400 * 7)
    local paceHour = hours > 0 and (rebirths / hours) or 0
    local paceDay  = days > 0 and (rebirths / days) or 0
    local paceWeek = weeks > 0 and (rebirths / weeks) or 0
    return formatNumber(paceHour), formatNumber(paceDay), formatNumber(paceWeek)
end

