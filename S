    lastRockTime = tick()

    task.spawn(function()
        while true do
            if getgenv()._AutoRepFarmEnabled then
                local ping = getPing()
                farmingPaused = ping > MAX_PING
            end
            task.wait(0.5)
        end
    end)

    task.spawn(function()
        while true do
            if getgenv()._AutoRepFarmEnabled and not farmingPaused then
                pcall(function() player.muscleEvent:FireServer("rep") end)
            end
            task.wait(math.random(REP_WAIT_MIN*10000, REP_WAIT_MAX*10000)/10000)
        end
    end)

    task.spawn(function()
        while true do
            if getgenv()._AutoRepFarmEnabled and not farmingPaused then
                local now = tick()
                if now - lastProteinEggTime >= PROTEIN_EGG_INTERVAL then
                    eatProteinEgg()
                    lastProteinEggTime = now
                end
                if now - lastRockTime >= ROCK_INTERVAL then
                    hitRock()
                    lastRockTime = now
                end
            end
            task.wait(1)
        end
    end)

    player.CharacterAdded:Connect(function()
        task.wait(3)
        updateCharacterRefs()
        equipBestPet()
    end)
end)

