local strengthTab = Window:AddTab("Strength Op")

getgenv()._AutoRepFarmEnabled = false

-- Config auto rep farm
local PET_NAMES = {"Swift Samurai", "Sarge"}
local PROTEIN_EGG_NAME = "ProteinEgg"
local PROTEIN_EGG_INTERVAL = 30 * 60
local ROCK_NAME = "Rock5M"
local ROCK_INTERVAL = 3
local MAX_PING = 500
local MIN_PING = 200
local REP_WAIT_MIN = 0.0003
local REP_WAIT_MAX = 0.0008
local farmingPaused = false

local HumanoidRootPart
local lastProteinEggTime = 0
local lastRockTime = 0

local function getPing()
    local s, p = pcall(function() return game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue() end)
    return s and p or 999
end

local function updateCharacterRefs()
    local char = player.Character or player.CharacterAdded:Wait()
    HumanoidRootPart = char:WaitForChild("HumanoidRootPart", 5)
end

local function equipBestPet()
    local pets = player:FindFirstChild("petsFolder")
    if pets and pets:FindFirstChild("Unique") then
        for _, name in ipairs(PET_NAMES) do
            for _, pet in pairs(pets.Unique:GetChildren()) do
                if pet.Name == name then
                    pcall(function() game.ReplicatedStorage.rEvents.equipPetEvent:FireServer("equipPet", pet) end)
                    return
                end
            end
        end
    end
end

local function eatProteinEgg()
    if player:FindFirstChild("Backpack") then
        for _, item in pairs(player.Backpack:GetChildren()) do
            if item.Name == PROTEIN_EGG_NAME then
                pcall(function() game.ReplicatedStorage.rEvents.eatEvent:FireServer("eat", item) end)
                return
            end
        end
    end
end

local function hitRock()
    local rock = workspace:FindFirstChild(ROCK_NAME)
    if rock and HumanoidRootPart then
        local ox = math.random(-30,30)/10
        local oz = -(4 + math.random(0,2))
        HumanoidRootPart.CFrame = rock.CFrame * CFrame.new(ox, 0, oz)
        task.wait(0.1)
        pcall(function() game.ReplicatedStorage.rEvents.hitEvent:FireServer("hit", rock) end)
    end
end

