local function formatTime(elapsed)
    local totalSec = math.floor(elapsed)
    local d = math.floor(totalSec / 86400)
    local h = math.floor((totalSec % 86400) / 3600)
    local m = math.floor((totalSec % 3600) / 60)
    local s = totalSec % 60
    return string.format("%dd %dh %dm %ds", d, h, m, s)
end

local function calculateDetailedPaces(delta, elapsed)
    local perSec = elapsed > 0 and (delta / elapsed) or 0
    return formatNumber(perSec), formatNumber(perSec*60), formatNumber(perSec*3600),
           formatNumber(perSec*86400), formatNumber(perSec*604800), formatNumber(perSec*2592000)
end

