    rebirthHistory = {}
    lblRebirthsInfo.Text = "Rebirths actuales: " .. formatNumber(rebirthStat.Value) .. " | Gained: 0"
end)

local lastRebirthValue = rebirthStat.Value
rebirthStat.Changed:Connect(function(newValue)
    if newValue > lastRebirthValue then
        local gained = newValue - lastRebirthValue
        if tracking then
            gainedRebirths = gainedRebirths + gained
            table.insert(rebirthHistory, {time = tick(), value = newValue})
        end
        lastRebirthValue = newValue
    end
end)

task.spawn(function()
    local lastCalc = tick()
    while true do
        task.wait(1)
        if tracking and startTimeRebirth > 0 then
            local now = tick()
            local elapsed = now - startTimeRebirth
            lblTimer.Text = formatTime(elapsed) .. " - Active"
            lblRebirthsInfo.Text = "Rebirths actuales: " .. formatNumber(rebirthStat.Value) .. " | Gained: " .. formatNumber(gainedRebirths)

            while #rebirthHistory > 0 and now - rebirthHistory[1].time > 10 do
                table.remove(rebirthHistory, 1)
            end

            if #rebirthHistory >= 2 then
                local delta = rebirthHistory[#rebirthHistory].value - rebirthHistory[1].value
                local timeSpan = rebirthHistory[#rebirthHistory].time - rebirthHistory[1].time
                local ps = delta / timeSpan
                lblCurrentPace.Text = "Pace: " .. formatNumber(math.floor(ps)) .. "/Seg | " ..
                                      formatNumber(math.floor(ps*60)) .. "/Min | " ..
                                      formatNumber(math.floor(ps*3600)) .. "/Hora"
            end
        end
    end
end)

