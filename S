end

local function equipBestPet()
    local petsFolder = player:FindFirstChild("petsFolder")
    if petsFolder and petsFolder:FindFirstChild("Unique") then
        for _, petName in ipairs(PET_NAMES) do
            for _, pet in pairs(petsFolder.Unique:GetChildren()) do
                if pet.Name == petName then
                    pcall(function()
                        game.ReplicatedStorage.rEvents.equipPetEvent:FireServer("equipPet", pet)
                    end)
                    warn("[Strength Op] Equipped: " .. petName)
                    return
                end
            end
        end
        warn("[Strength Op] No optimal pet found!")
    end
end

-- Función Eat Protein Egg (la que me pasaste)
local function eatProteinEggNew()
    local backpack = player:WaitForChild("Backpack", 5)
    local character = player.Character or player.CharacterAdded:Wait()

    if not backpack or not character then
        warn("[AutoEgg] Backpack o Character no disponibles.")
        return
    end

    local egg = backpack:FindFirstChild(PROTEIN_EGG_NAME)
    if egg then
        egg.Parent = character
        task.wait(0.1)
        pcall(function()
            egg:Activate()
            print("[AutoEgg] Protein Egg consumido.")
        end)
    else
        warn("[AutoEgg] No se encontró Protein Egg en Backpack.")
    end
end

local function hitRock()
    local rock = workspace:FindFirstChild(ROCK_NAME)
    if rock and HumanoidRootPart then
        local offsetX = math.random(-30, 30) / 10
        local offsetZ = -(4 + math.random(0, 2))
        HumanoidRootPart.CFrame = rock.CFrame * CFrame.new(offsetX, 0, offsetZ)
        task.wait(0.1)
        pcall(function()
            game.ReplicatedStorage.rEvents.hitEvent:FireServer("hit", rock)
        end)
    end
end

